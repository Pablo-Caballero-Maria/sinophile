# Copy to .env.local (never commit real values). In Vercel: Settings → Environment Variables.
# Connection string of the MongoDB Atlas cluster (secret).
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/
# Database name (defaults to "sinophile"; use another one for local development).
MONGODB_DB=sinophile_dev
# Signs Better Auth's session cookies (secret; required in production). Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
