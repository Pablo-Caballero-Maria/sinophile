{
  "name": "sinophile",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/prepare-data.ts",
    "predev": "npm run prepare-data",
    "dev": "next dev",
    "prebuild": "npm run prepare-data",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run prepare-data",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run prepare-data",
    "test": "vitest run",
    "test:coverage": "npm test -- --coverage",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "validate": "node scripts/prepare-data.ts --check",
    "dictionary": "node scripts/build-dictionary.ts",
    "hsk": "node scripts/build-hsk.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.6",
    "@vercel/speed-insights": "^2.1.0",
    "canvas-confetti": "^1.9.4",
    "hanzi-writer": "^3.7.3",
    "lucide-react": "^1.67.0",
    "mongodb": "^7.8.0",
    "next": "16.4.6",
    "pinyin-pro": "^3.29.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
