    "jia": {
      "note": "«Casa» en el sentido de hogar, y también «familia»: 我家 = mi casa o mi familia (con la familia no hace falta 的). 在家 = en casa. 房子 (lección 3) es la casa como edificio. El carácter es un tejado (宀) con un cerdo (豕) debajo: la casa de una familia de campesinos.",
      "examples": [
        {
          "zh": ["我", "家", "在", "伦敦", "。"],
          "pinyin": "Wǒ jiā zài Lúndūn.",
          "es": "Mi casa está en Londres."
        },
        {
          "zh": ["我", "妈妈", "在", "家", "。"],
          "pinyin": "Wǒ māma zài jiā.",
          "es": "Mi madre está en casa."
        },
        {
          "zh": ["你", "家", "有", "汽车", "吗", "？"],
          "pinyin": "Nǐ jiā yǒu qìchē ma?",
          "es": "¿Tu familia tiene coche?"
        }
      ],
      "exercises": [
        {
          "type": "fill",
          "example": 1,
          "distractors": ["教室", "乡村"]
        },
        {
          "type": "translate",
          "example": 0,
          "direction": "es-zh",
          "distractors": ["是", "上"]
        },
        {
          "type": "translate",
          "example": 2,
          "direction": "zh-es",
          "distractors": ["padres", "tienes"],
          "accept": ["¿Tiene coche tu familia?"]
        },
        {
          "type": "choice",
          "question": "¿Qué diferencia hay entre 家 y 房子?",
          "options": ["家 es el hogar (y la familia); 房子, el edificio", "Ninguna: significan siempre lo mismo", "家 es un piso y 房子, una casa de campo"],
          "answer": "家 es el hogar (y la familia); 房子, el edificio",
          "explanation": "Se dice 我在家 (estoy en casa) y 我家有车 (mi familia tiene coche); 房子 es la vivienda como construcción: 他们没有房子."
        }
      ]
    },
