    "jiao": {
      "note": "«Llamarse». Para decir tu nombre: 我叫 + nombre (我叫Pablo). Para preguntarlo: 你叫什么名字？ (literalmente «¿cómo te llamas de nombre?»). 叫 ya es el verbo, así que no lleva 是: 我叫Pablo, no 我是叫Pablo.",
      "examples": [
        {
          "zh": ["你", "叫", "什么", "名字", "？"],
          "pinyin": "Nǐ jiào shénme míngzi?",
          "es": "¿Cómo te llamas?"
        },
        {
          "zh": ["他", "叫", "什么", "名字", "？"],
          "pinyin": "Tā jiào shénme míngzi?",
          "es": "¿Cómo se llama él?"
        },
        {
          "zh": ["你", "的", "老师", "叫", "什么", "名字", "？"],
          "pinyin": "Nǐ de lǎoshī jiào shénme míngzi?",
          "es": "¿Cómo se llama tu profesor?"
        }
      ],
      "exercises": [
        {
          "type": "fill",
          "example": 1,
          "distractors": ["是", "有"]
        },
        {
          "type": "translate",
          "example": 2,
