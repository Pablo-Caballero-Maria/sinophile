    "shei": {
      "note": "«Quién». La pregunta no cambia el orden de la frase: 谁 va donde iría la respuesta (他是谁？ → 他是我哥哥。). 谁的 es «de quién». También se oye shuí.",
      "examples": [
        {
          "zh": [
            "他",
            "是",
            "谁",
            "？"
          ],
          "pinyin": "Tā shì shéi?",
          "es": "¿Quién es él?"
        },
        {
          "zh": [
            "这",
            "是",
            "谁",
            "的",
            "手机",
            "？"
          ],
          "pinyin": "Zhè shì shéi de shǒujī?",
          "es": "¿De quién es este móvil?"
        },
        {
          "zh": [
            "谁",
            "是",
            "你",
            "的",
            "老师",
            "？"
          ],
          "pinyin": "Shéi shì nǐ de lǎoshī?",
          "es": "¿Quién es tu profesor?"
