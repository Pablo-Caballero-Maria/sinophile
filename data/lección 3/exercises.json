      "examples": [
        {
          "zh": ["我", "有", "一", "本书", "。"],
          "pinyin": "Wǒ yǒu yì běn shū.",
          "es": "Tengo un libro."
        },
        {
          "zh": ["老师", "有", "四", "十", "本书", "。"],
          "pinyin": "Lǎoshī yǒu sìshí běn shū.",
          "es": "El profesor tiene cuarenta libros."
        },
        {
          "zh": ["我", "买", "三", "本书", "。"],
          "pinyin": "Wǒ mǎi sān běn shū.",
          "es": "Compro tres libros."
        }
      ],
      "exercises": [
